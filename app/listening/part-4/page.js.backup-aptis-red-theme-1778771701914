          font-weight: 900;
          text-align: center;
          padding: 38px;
        }

        @media (max-width: 760px) {
          .audioBar {
            grid-template-columns: 1fr;
          }

          .questionCard {
            padding: 26px 20px;
          }

          .bottomNav {
            grid-template-columns: 1fr;
            position: static;
            margin-top: 24px;
            padding: 14px;
          }

          .bottomNav .checkBtn {
