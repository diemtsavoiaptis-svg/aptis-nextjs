          font-weight: 900;
        }

        .optionList {
          display: grid;
          gap: 22px;
        }

        .optionRow {
          display: flex;
          align-items: center;
          gap: 14px;
          color: #263247;
          font-size: 18px;
          line-height: 1.45;
          cursor: pointer;
        }

        .optionRow input {
          width: 20px;
