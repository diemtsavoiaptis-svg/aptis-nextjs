        }

        .questionCard {
          border: 1px solid #ffc3d8;
          border-radius: 18px;
          background: white;
          padding: 38px 42px;
          margin-bottom: 28px;
        }

        .questionCard h2 {
          margin: 0 0 30px;
          color: #8d0645;
