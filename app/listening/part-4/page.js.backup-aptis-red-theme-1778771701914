          accent-color: #c91664;
          flex-shrink: 0;
        }

        .correctOption span {
          color: #067a3a;
          font-weight: 900;
        }

        .resultText {
          margin: 16px 0 0 34px;
          font-weight: 900;
        }

        .correctText {
          color: #067a3a;
        }

        .wrongText {
          color: #d90429;
        }

        .missingText {
          color: #9b6500;
        }

        .bottomNav {
          position: fixed;
          left: 0;
          right: 0;
          bottom: 0;
          min-height: 82px;
          display: grid;
          grid-template-columns: 180px 1fr 180px;
          align-items: center;
          gap: 20px;
          padding: 14px 46px;
          background: rgba(255, 240, 246, 0.96);
          border-top: 1px solid #ffc3d8;
          backdrop-filter: blur(12px);
          z-index: 20;
        }

        .bottomNav button {
          min-height: 52px;
          border-radius: 14px;
          border: 1px solid #ffc3d8;
          background: white;
          color: #c91664;
          font-size: 18px;
          font-weight: 900;
          cursor: pointer;
        }

        .bottomNav .checkBtn {
          width: min(220px, 100%);
          justify-self: center;
          background: #c91664;
          color: white;
          border-color: #c91664;
          box-shadow: 0 12px 20px rgba(199, 22, 100, 0.18);
        }

        .bottomNav button:disabled {
          opacity: 0.45;
          cursor: not-allowed;
        }

        .emptyBox {
          width: min(760px, 100%);
          margin: 80px auto;
          border-radius: 20px;
          border: 1px solid #ffc3d8;
