"use client";

import { useEffect, useMemo, useState } from "react";

const letters = ["A", "B", "C"];

function normalize(value) {
  return String(value || "").trim().toLowerCase().replace(/\s+/g, " ");
}

function pick(row, keys) {
  for (const key of keys) {
    const value = row?.[key];

    if (value !== undefined && value !== null && String(value).trim() !== "") {
      return String(value).trim();
    }
  }

  return "";
}

function extractDriveId(url) {
  const text = String(url || "");
  const match = text.match(/\/d\/([^/]+)/);
  return match ? match[1] : "";
}

function getAudioSrc(row) {
  const audioLink = pick(row, ["audioLink", "audio", "linkAudio", "Link Audio"]);
  const driveId =
    pick(row, ["audio_drive_file_id", "audioDriveFileId", "driveFileId"]) ||
    extractDriveId(audioLink);

  if (driveId) return `/api/audio?id=${encodeURIComponent(driveId)}`;
  return audioLink;
}

function compactParagraph(text) {
  return String(text || "")
    .trim()
    .replace(/\s+/g, " ")
    .replace(/\b(Speaker|Narrator|Man|Woman|M|W)\s*:/g, "\n$1:")
    .replace(/^\n/, "");
}

function getQuestionSet(row) {
  const q16 = pick(row, [
    "question16",
    "question_16",
    "q16",
    "cauHoi16",
    "cauhoi16",
    "Câu hỏi 16",
    "Cau hoi 16",
    "Question 16",
  ]);

  const q17 = pick(row, [
    "question17",
    "question_17",
    "q17",
    "cauHoi17",
    "cauhoi17",
    "Câu hỏi 17",
    "Cau hoi 17",
    "Question 17",
  ]);

  const q16Choices = [
    pick(row, ["answer1", "answerA", "optionA16", "choiceA16", "Trả lời 1", "Tra loi 1", "Answer 1"]),
    pick(row, ["answer2", "answerB", "optionB16", "choiceB16", "Trả lời 2", "Tra loi 2", "Answer 2"]),
    pick(row, ["answer3", "answerC", "optionC16", "choiceC16", "Trả lời 3", "Tra loi 3", "Answer 3"]),
  ];

  const q17Choices = [
    pick(row, ["choice1", "choiceA", "optionA17", "choiceA17", "Lựa chọn 1", "Lua chon 1", "Choice 1"]),
    pick(row, ["choice2", "choiceB", "optionB17", "choiceB17", "Lựa chọn 2", "Lua chon 2", "Choice 2"]),
    pick(row, ["choice3", "choiceC", "optionC17", "choiceC17", "Lựa chọn 3", "Lua chon 3", "Choice 3"]),
  ];

  const q16Correct = pick(row, [
    "correct16",
    "answer16",
    "correctAnswer16",
    "Đáp án 16",
    "Dap an 16",
  ]);

  const q17Correct = pick(row, [
    "correct17",
    "answer17",
    "correctAnswer17",
    "Đáp án 17",
    "Dap an 17",
  ]);

  return [
    {
      id: "16",
      title: "16.1",
      question: q16,
      choices: q16Choices,
      correct: q16Correct,
    },
    {
      id: "17",
      title: "16.2",
      question: q17,
      choices: q17Choices,
      correct: q17Correct,
    },
  ].filter((item) => item.question || item.choices.some(Boolean));
}

function correctLetter(question) {
  const raw = String(question.correct || "").trim();
  const upper = raw.toUpperCase();

  if (["A", "B", "C"].includes(upper)) return upper;

  const index = question.choices.findIndex((choice) => normalize(choice) === normalize(raw));
  return letters[index] || "";
}

export default function ListeningPart4Page() {
  const [mode, setMode] = useState("guest");
  const [rows, setRows] = useState([]);
  const [activeIndex, setActiveIndex] = useState(0);
  const [answers, setAnswers] = useState({});
  const [checked, setChecked] = useState(false);
  const [showParagraph, setShowParagraph] = useState(false);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    const params = new URLSearchParams(window.location.search);
    const currentMode = params.get("mode") === "student" ? "student" : "guest";
    setMode(currentMode);

    async function loadData() {
      try {
        const file =
          currentMode === "student"
            ? "/data/part4-full.json"
            : "/data/part4-admin.json";

        const res = await fetch(file, { cache: "no-store" });
        if (!res.ok) throw new Error("Cannot load Part 4 data");

        const data = await res.json();
        const list = Array.isArray(data) ? data : data.rows || [];

        const nextRows =
          currentMode === "student"
            ? list
            : list.filter((row) => row.showInGuest || row.guestVisible);

        setRows(nextRows);
        setActiveIndex(0);
      } catch (error) {
        console.error(error);
        setRows([]);
      } finally {
        setLoading(false);
      }
    }

    loadData();
  }, []);

  const currentRow = rows[activeIndex] || {};
  const questions = useMemo(() => getQuestionSet(currentRow), [currentRow]);
  const currentAnswers = answers[activeIndex] || {};
  const paragraph = compactParagraph(
    pick(currentRow, ["paraphrase", "voiceParagraph", "transcript", "Dữ liệu paraphrase"])
  );

  function chooseAnswer(questionId, value) {
    setAnswers((old) => ({
      ...old,
      [activeIndex]: {
        ...(old[activeIndex] || {}),
        [questionId]: value,
      },
    }));

    setChecked(false);
  }

  function checkResult() {
    setChecked(true);
  }

  function resultOf(question) {
    const selected = currentAnswers[question.id];

    if (!selected) return "missing";

    const correct = correctLetter(question);

    if (!correct) return "info";

    return normalize(selected) === normalize(correct) ? "correct" : "wrong";
  }

  function goBack() {
    setActiveIndex((index) => Math.max(0, index - 1));
    setChecked(false);
    setShowParagraph(false);
  }

  function goNext() {
    setActiveIndex((index) => Math.min(rows.length - 1, index + 1));
    setChecked(false);
    setShowParagraph(false);
  }

  if (loading) {
    return (
      <main className="part4PracticePage">
        <div className="emptyBox">Đang tải dữ liệu Part 4...</div>
      </main>
    );
  }

  if (!rows.length) {
    return (
      <main className="part4PracticePage">
        <div className="emptyBox">
          {mode === "student"
            ? "Chưa có dữ liệu Part 4."
            : "Chưa có bài Part 4 nào được chọn cho giao diện khách."}
        </div>
      </main>
    );
  }

  return (
    <main className="part4PracticePage">
      <section className="practiceShell">
        <h1 className="pageTitle">
          Question {activeIndex + 1} of {rows.length}
        </h1>

        <section className="audioBar">
          <div className="audioWrap">
            {getAudioSrc(currentRow) ? (
              <audio controls src={getAudioSrc(currentRow)} />
            ) : (
              <span>Chưa có audio.</span>
            )}
          </div>

          <strong>2 of 2 plays remaining</strong>
        </section>

        <button
          type="button"
          className="showParagraphBtn"
          onClick={() => setShowParagraph((value) => !value)}
        >
          {showParagraph ? "Hide Paragraph" : "Show Paragraph"}
        </button>

        {showParagraph && (
          <section className="paragraphBox">
            {paragraph || "Chưa có dữ liệu paragraph."}
          </section>
        )}

        <section className="questionCard">
          <h2>Topic: {pick(currentRow, ["topic", "Chủ đề", "Chu de"]) || "Chưa có chủ đề"}</h2>

          {questions.length ? (
            questions.map((question) => {
              const selected = currentAnswers[question.id] || "";
              const result = checked ? resultOf(question) : "";
              const correct = correctLetter(question);

              return (
                <article key={question.id} className="questionBlock">
                  <h3>
                    {question.title} {question.question || "Chưa có câu hỏi."}
                  </h3>

                  <div className="optionList">
                    {question.choices.map((choice, index) => {
                      const letter = letters[index];
                      const optionId = `${question.id}-${letter}`;

                      return (
                        <label
                          key={optionId}
                          className={
                            checked && correct === letter
                              ? "optionRow correctOption"
                              : "optionRow"
                          }
                        >
                          <input
                            type="radio"
                            name={`question-${question.id}`}
                            value={letter}
                            checked={selected === letter}
                            onChange={() => chooseAnswer(question.id, letter)}
                          />
                          <span>{choice || `Lựa chọn ${letter}`}</span>
                        </label>
                      );
                    })}
                  </div>

                  {checked && result === "correct" && (
                    <p className="resultText correctText">Chính xác.</p>
                  )}

                  {checked && result === "wrong" && (
                    <p className="resultText wrongText">
                      Chưa đúng. Đáp án đúng: {correct || question.correct}
                    </p>
                  )}

                  {checked && result === "missing" && (
                    <p className="resultText missingText">Chưa chọn đáp án.</p>
                  )}

                  {checked && result === "info" && (
                    <p className="resultText missingText">
                      Câu này chưa có đáp án đúng trong dữ liệu.
                    </p>
                  )}
                </article>
              );
            })
          ) : (
            <div className="noQuestionBox">
              Chưa đọc được câu hỏi 16/17 từ dữ liệu. Vui lòng kiểm tra tên cột trong Admin Part 4.
            </div>
          )}
        </section>
      </section>

      <nav className="bottomNav">
        <button type="button" onClick={goBack} disabled={activeIndex === 0}>
          BACK
        </button>

        <button type="button" className="checkBtn" onClick={checkResult}>
          Check result
        </button>

        <button
          type="button"
          onClick={goNext}
          disabled={activeIndex === rows.length - 1}
        >
          NEXT
        </button>
      </nav>

      <style jsx global>{`
