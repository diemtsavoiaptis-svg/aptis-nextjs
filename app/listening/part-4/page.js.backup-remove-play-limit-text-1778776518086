          height: 34px;
        }

        .audioWrap span {
          font-weight: 900;
        }

        .audioBar strong {
          white-space: nowrap;
          font-size: 16px;
        }

        .showParagraphBtn {
          min-width: 190px;
          min-height: 52px;
          border-radius: 999px;
          border: 1px solid #ffc0cc;
          background: white;
          color: #e6003f;
          font-size: 17px;
          font-weight: 900;
          cursor: pointer;
          margin-bottom: 28px;
        }

        .paragraphBox {
          max-height: 170px;
          overflow-y: auto;
          white-space: pre-wrap;
          border-radius: 18px;
          border: 1px solid #ffc0cc;
