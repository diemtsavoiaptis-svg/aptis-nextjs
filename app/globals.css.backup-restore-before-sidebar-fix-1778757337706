@import "tailwindcss";

:root {
  --aptis-red: #d6002d;
  --aptis-soft: #ffe3e8;
  --aptis-text: #4a0716;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  color: var(--aptis-text);
  background:
    radial-gradient(circle at 12% 12%, rgba(255,255,255,.88), transparent 28%),
    radial-gradient(circle at 86% 16%, rgba(255, 173, 188, .44), transparent 32%),
    linear-gradient(135deg, #fff7f7 0%, #ffe3e8 48%, #f7bdc8 100%);
}

.admin-skill-link {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 16px;
  border-radius: 22px;
  color: #6b1230;
  text-decoration: none;
  transition: 0.22s ease;
}

.admin-skill-link:hover {
  background: #fff1f5;
  transform: translateX(3px);
}

.admin-skill-link span {
  width: 58px;
  height: 58px;
  display: grid;
  place-items: center;
  border-radius: 18px;
  background: #ffe0e7;
  color: #d60045;
  font-weight: 1000;
  font-size: 20px;
}

.admin-skill-link strong {
  display: block;
  font-size: 20px;
  font-weight: 1000;
}

.admin-skill-link small {
  display: block;
  margin-top: 7px;
  color: #b56a82;
  font-weight: 800;
}

.admin-skill-link.locked {
  opacity: .65;
}

/* Skill sidebar polish */
.admin-skill-link span {
  font-size: 18px !important;
  letter-spacing: 0.03em;
}

.admin-skill-link strong {
  text-transform: uppercase;
  letter-spacing: 0.02em;
}

